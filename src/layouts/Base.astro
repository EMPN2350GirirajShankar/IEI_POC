---
import '../styles/site.css';
import Iris from '../components/Iris.astro';
const { lang, slug, title, nav, hasTwin } = Astro.props;
const other = lang === 'en' ? 'hi' : 'en';
const switchHref = `/${other}/${hasTwin && slug !== 'home' ? slug + '/' : ''}`;
const ui = lang === 'hi'
  ? { switch: 'English', skip: 'मुख्य सामग्री पर जाएँ', foot: 'यह एक प्रोटोटाइप है; सामग्री उदाहरण मात्र है।' }
  : { switch: 'हिंदी', skip: 'Skip to content', foot: 'Prototype site. Content is placeholder text.' };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | IndiaEye</title>
    <link rel="alternate" hreflang={other} href={switchHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;600&family=Tiro+Devanagari+Hindi&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <header class="bar">
      <a class="brand" href={`/${lang}/`}><Iris /><span>IndiaEye</span></a>
      <nav aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={n.slug === slug ? 'page' : undefined}>{n.title}</a>)}
      </nav>
      <a class="lang" href={switchHref} lang={other} hreflang={other}>{ui.switch}</a>
    </header>
    <main id="main"><slot /></main>
    <footer><p>{ui.foot}</p></footer>
  </body>
</html>
